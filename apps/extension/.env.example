# 开发态预置配置示例
#
# 用法：复制成 .env.local（已 gitignore），按需填写，然后 `pnpm dev:extension`。
# background 启动时会把这些值写入扩展存储，省去每次新 dev profile 都手动配置。
#
# 说明：
# - 变量必须以 WXT_ 开头，否则不会注入到扩展代码里；
# - 只在开发构建生效，生产构建整段逻辑会被移除，密钥不会打包进产物；
# - 默认只在对应配置为空时写入，不会覆盖你在设置页改过的值。
# - 详见 docs/dev-config-preset.md

# 每次启动都强制覆盖已有配置（默认 false，只在配置为空时写入）
# WXT_DEV_PRESET_FORCE=false

# ---------- AI 模型 ----------
# provider 可选：openai / anthropic / google / azure / deepseek / groq / mistral /
#               moonshot / zhipu / hunyuan / nvidia / siliconflow / ollama / custom
WXT_DEV_AI_PROVIDER=openai
WXT_DEV_AI_API_KEY=sk-your-key
# 自定义端点（ollama / custom / 中转服务时填写）
# WXT_DEV_AI_BASE_URL=https://api.openai.com/v1
WXT_DEV_AI_MODEL=gpt-4o-mini

# ---------- Embedding（语义搜索）----------
# WXT_DEV_EMBEDDING_ENABLED=true
# WXT_DEV_EMBEDDING_PROVIDER=openai
# WXT_DEV_EMBEDDING_API_KEY=sk-your-key
# WXT_DEV_EMBEDDING_BASE_URL=
# WXT_DEV_EMBEDDING_MODEL=text-embedding-3-small

# ---------- 常用设置 ----------
# 语言：zh / en
# WXT_DEV_LANGUAGE=zh
# 主题：light / dark / system
# WXT_DEV_THEME=system
# 保存书签时默认保存快照
# WXT_DEV_AUTO_SAVE_SNAPSHOT=true

# ---------- WebDAV 同步 ----------
# WXT_DEV_WEBDAV_ENABLED=true
# WXT_DEV_WEBDAV_URL=https://dav.example.com/hamhome
# WXT_DEV_WEBDAV_USERNAME=your-name
# WXT_DEV_WEBDAV_PASSWORD=your-password

# ---------- WXT 开发浏览器 ----------
# 仅用于 `pnpm dev:ext-edge` 自动启动 Edge，不会注入扩展代码。
# macOS 示例：
# WXT_EDGE_BINARY="/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
