{
  "name": "hamhome",
  "version": "1.2.0",
  "private": true,
  "description": "HamHome 浏览器插件",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:all": "pnpm build && pnpm build:firefox && pnpm build:edge",
    "analyze": "ANALYZE=true wxt build",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:all": "pnpm zip && pnpm zip:firefox && pnpm zip:edge",
    "clean": "rm -rf .wxt .output dist",
    "submit:init": "wxt submit init",
    "submit:all": "node scripts/submit.js",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "HEADED=1 playwright test --config e2e/playwright.config.ts",
    "test:e2e:default": "playwright test --config e2e/playwright.config.ts --project chromium-extension",
    "test:e2e:english": "playwright test --config e2e/playwright.config.ts --project chromium-extension-english",
    "test:e2e:dark": "playwright test --config e2e/playwright.config.ts --project chromium-extension-dark",
    "test:e2e:desktop": "HEADED=1 E2E_DESKTOP_SCREENSHOT=1 playwright test --config e2e/playwright.config.ts --project chromium-extension-desktop",
    "screenshots": "playwright test --config e2e/screenshots/playwright.config.ts",
    "screenshots:headed": "HEADED=1 playwright test --config e2e/screenshots/playwright.config.ts",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hamhome/agent": "workspace:*",
    "@hamhome/ui": "workspace:*",
    "@hamhome/ui-business": "workspace:*",
    "@hamhome/utils": "workspace:*",
    "@mozilla/readability": "^0.5.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@webext-core/proxy-service": "^2.0.0",
    "defuddle": "^0.14.0",
    "fflate": "^0.8.2",
    "i18next": "^24.0.0",
    "i18next-browser-languagedetector": "^7.0.0",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.0",
    "p-limit": "^7.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "webdav": "^5.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/chrome": "^0.0.260",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@wxt-dev/module-react": "^1.1.5",
    "postcss-rem-to-pixel": "^4.1.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wxt": "^0.20.13"
  }
}
